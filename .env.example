# Copy this file to `.env` and adjust the values. `.env` is git-ignored.
# Every variable must start with VITE_ to be exposed to the browser bundle.
VITE_APP_ENV=dev

# The Firebase project's web app: Project settings > Your apps > SDK setup and
# configuration (docs/firebase.md). These defaults point at the local
# emulators instead, which take any values for a `demo-` project: run
# `npm run emulators` next to `npm run dev`. For a real project, paste its
# values and set VITE_FIREBASE_USE_EMULATORS=false.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-expensify.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-expensify
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_USE_EMULATORS=true

# Optional: App Check with reCAPTCHA Enterprise (docs/firebase.md, step 8).
# Leave the site key empty to run without App Check.
VITE_APP_CHECK_SITE_KEY=
VITE_APP_CHECK_DEBUG=false
